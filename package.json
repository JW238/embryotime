{
  "name": "embryotime",
  "version": "0.3.0",
  "private": true,
  "description": "Chicken embryo incubation scheduler for lab researchers",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:release": "node scripts/build.mjs --out .release-preview && SITE_ROOT=.release-preview node server.js",
    "build": "node scripts/build.mjs --out docs",
    "test": "node --test tests/*.test.js",
    "test:browser": "node --test --test-concurrency=1 --test-timeout=60000 tests/browser/*.test.js",
    "test:all": "npm test && npm run test:browser"
  },
  "engines": {
    "node": ">=22"
  }
}
